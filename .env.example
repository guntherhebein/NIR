# --- Quelle: HTTP-Verzeichnislisting (Apache/nginx Autoindex) ---
BASE_URL=http://10.139.13.121/Protocols/
# Nur setzen, falls der Webserver Basic-Auth verlangt (sonst leer lassen):
HTTP_AUTH_USER=
HTTP_AUTH_PASS=
HTTP_VERIFY_SSL=true
HTTP_TIMEOUT_SECONDS=30

# --- MongoDB ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_mongo
MONGO_DB=protocol_archive
MONGO_URI=mongodb://admin:changeme_mongo@mongo:27017/protocol_archive?authSource=admin

# --- Watcher ---
POLL_INTERVAL_SECONDS=60
RECHECK_DAYS=2
STORAGE_PATH=/storage

# --- Webapp ---
WEB_PORT=8080